if ($_SERVER["REQUEST_METHOD"] == "POST") {

    // Store user input in array
    $fruits = array(
        $_POST['fruit1'],
        $_POST['fruit2'],
        $_POST['fruit3']
    );

    echo "<h3>Array Values:</h3>";
    echo "<ul>";

    for ($i = 0; $i < count($fruits); $i++) {
        echo "<li>" . htmlspecialchars($fruits[$i]) . "</li>";
    }

    echo "</ul>";
}
