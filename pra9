from sklearn.metrics import silhouette_score, calinski_harabasz_score, davies_bouldin_score
# Ensure hc_clusters variable is assigned from y_hc
hc_clusters = y_hc

# K-Metrics (using x)
km_sil = silhouette_score(x, y_predict)
km_ch = calinski_harabasz_score(x, y_predict)
# Hierarchical Metrics
hc_sil = silhouette_score(x, hc_clusters)
hc_ch = calinski_harabasz_score(x, hc_clusters)

comparison = pd.DataFrame({
    "Metric": [
        "Silhouette Score",
        "Calinski-Harabasz Index",
    ],
    "K-Means": [
        km_sil,
        km_ch,
    ],
    "Hierarchical": [
        hc_sil,
        hc_ch,
    ]
})
print("\nClustering Algorithm Comparison:")
print(comparison.round(4))
