    if ($_SERVER["REQUEST_METHOD"] == "POST") {

        $str = $_POST['str'];

        $length = strlen($str);
        $reverse = strrev($str);
        $substring = substr($str, 0, 5);

       
        echo "<p><b>Length:</b> <span class='highlight'>$length</span></p>";
        echo "<p><b>Reversed:</b> <span class='highlight'>$reverse</span></p>";
