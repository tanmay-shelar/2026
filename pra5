from sklearn.preprocessing import StandardScaler, MinMaxScaler

numeric_var = df.select_dtypes(include='number').columns
X_num = df[numeric_var]

# Standardization (Z-score)
scaler_std = StandardScaler()
X_standardized = scaler_std.fit_transform(X_num)
print("Standardized data sample:\n", X_standardized[:2])

# Normalization (Min-Max)
scaler_minmax = MinMaxScaler()
X_normalized = scaler_minmax.fit_transform(X_num)
print("\nNormalized data sample:\n", X_normalized[:2])


