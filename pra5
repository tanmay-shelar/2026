# BFS for Robot Path Planning

from collections import deque

# Grid: 0 = Free path, 1 = Obstacle
grid = [
    [0, 0, 1],
    [1, 0, 1],
    [0, 0, 0]
]

start = (0, 0)
goal = (2, 2)

# BFS Algorithm
def bfs(start, goal):
    queue = deque([[start]])
    visited = {start}

    while queue:
        path = queue.popleft()
        x, y = path[-1]

        if (x, y) == goal:
            return path

        for dx, dy in [(1, 0), (0, 1), (-1, 0), (0, -1)]:
            nx, ny = x + dx, y + dy

            if (0 <= nx < 3 and 0 <= ny < 3 and
                grid[nx][ny] == 0 and (nx, ny) not in visited):

                visited.add((nx, ny))
                queue.append(path + [(nx, ny)])

    return None
