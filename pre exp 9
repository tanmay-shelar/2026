Write and execute suitable database triggers. Consider row level and  
statement level triggers. 

show databases;  
use seit26;  
create table emp1 as select * from emp;  
create table dept1 as select * from dept;  
delimiter /  
create trigger dept1Delete   
after delete on dept1   
for each row  
begin  
declare x int;  
set x = old.deptno;  
delete from emp1 where deptno = x;  
end; /  
delimiter ;  
select * from emp1;  
delete from dept1 where deptno=10;  
select * from emp1;  
drop table emp1;  
create table emp1 as select * from emp;  
create table totalsal as select deptno, sum(sal) sal from emp1 group by deptno;  
Select * from totalsal;  
delimiter /  
create trigger emp1Update   
after update on emp1   
for each row  
begin  
if old.sal <> new.sal then  
update totalSal set sal = sal - old.sal + new.sal where deptno = new.deptno;  
end if;  
end; /  
delimiter ;  
Select * from emp1;  
Select * from totalsal;  
update emp1 set sal = sal-100 where deptno=20;  
select * from totalSal;  
drop trigger dept1Delete;  
drop trigger emp1Update; 
