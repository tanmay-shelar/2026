Write a PL/SQL block to implement all types of cursor. 
 
 
show databases; 
use seit26; 
create table emp1 as select * from emp; 
select * from emp1; 
drop procedure if exists findMinSal; 
 
delimiter // 
create procedure findMinSal( 
    in deptno1 int, 
    out ename1 varchar(20) 
) 
begin 
    declare s1 float; 
    declare ename2 varchar(20); 
    declare minName varchar(20); 
    declare minSal float; 
    declare done int default 0; 
    declare c1 cursor for 
        select ename, sal 
        from emp1 
        where deptno = deptno1; 
    declare continue handler for not found set done = 1; 
    open c1; 
    fetch c1 into ename2, s1; 
    if done = 0 then 
        set minSal = s1; 
        set minName = ename2; 
    end if; 
    l1: loop 
        fetch c1 into ename2, s1; 
        if done = 1 then 
            leave l1; 
        end if; 
        if s1 < minSal then 
            set minSal = s1; 
            set minName = ename2; 
        end if; 
    end loop; 
    close c1; 
    set ename1 = minName; 
end // 
delimiter ; 
 
call findMinSal(10, @r); 
select @r;
