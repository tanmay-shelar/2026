Create table with primary key and foreign key constraints 
a. Alter table with add n nodify  
b. Drop table 

 
  
show databases; 
use seit26; 
create table emp1( 
    empno int, 
    ename varchar(20), 
    job char(10), 
    mgr int, 
    hiredate date, 
    sal float, 
    comm float, 
    deptno int 
); 
desc emp1; 
alter table emp1 add gread varchar(10); 
desc emp1; 
alter table emp1 drop column gread; 
desc emp1; 
alter table emp1 add constraint empno_p primary key (empno); 
desc emp1; 
alter table emp1 drop primary key; 
desc emp1; 
alter table emp1 add constraint sal_c check (sal > 100); 
desc emp1; 
alter table emp1 modify sal int(10); 
desc emp1; 
alter table emp1 drop column sal; 
desc emp1; 
drop table emp1; 
