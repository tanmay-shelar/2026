delimiter /   
create procedure incrSal(in empno1 int)   
begin   
declare sal1 float(10,2);  
select sal into sal1 from emp where empno = empno1;  
if sal1 >3000 then  
update emp1 set sal= sal+ sal*10 where empno= empno1;  
else  
update emp1 set sal = 3000 where empno = empno1;  
end if;  
end;  
/   
delimiter ;  
call incrSal(7934);  
select * from emp1;  
drop procedure incrSal;  
