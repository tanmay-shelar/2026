Perform following SQL queries on the database SEIT 
I. List all employees who are managers.  
II. List all employees who receives null commission  
III. List all employees who receives salary between 1000 and 3000.  
IV. List all employees whose name ends with ‘s’.  
V. List all employees order by salary in descending order  
VI. List minimum salary paid in department 20.  
VII. List total salary paid in department 10.  
VIII. List the department int and total salary payable to each department  
IX. List details of all employees like empno, ename, sal, corresponding deptno, dname, loc 
from emp and dept table.  
X. List details of all employees like empno, ename, sal, corresponding deptno, dname, loc 
from emp and dept table. Also display department with no employee.



show databases; 
use seit26; 
select * from emp where job = 'manager'; 
select *from emp where comm is null; 
select * from emp where sal between 1000 and 3000; 
select * from emp where ename like '%s'; 
select * from emp order by sal desc; 
select min(sal) as minimum_salary from emp where deptno = 20; 
select sum(sal) as total_salary from emp where deptno = 10; 
select deptno, sum(sal) as total_salary from emp group by deptno; 
select e.empno, e.ename, e.sal, d.deptno, d.dname, d.loc from emp e inner join dept d on 
e.deptno = d.deptno; 
select e.empno, e.ename, e.sal, d.deptno, d.dname, d.loc from dept d left join emp e on 
e.deptno = d.deptno; 
