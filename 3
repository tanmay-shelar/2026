Create a table emp1 same as emp. 
Write a plsql block which will insert all the details of employee in given department to a new 
table emp1.(use cursor) 



show databases; 
use seit26; 
create table emp1 as select * from emp where 1=2; 
delimiter // 
create procedure insert_emp1(in dno int) 
begin 
declare done int default 0; 
declare v_empno int; 
declare v_ename varchar(20); 
declare v_job char(10); 
declare v_mgr int; 
declare v_hiredate date; 
declare v_sal float; 
declare v_comm float; 
declare v_deptno int; 
declare emp_cursor cursor for 
select empno, ename, job, mgr, hiredate, sal, comm, deptno 
from emp 
where deptno = dno; 
declare continue handler for not found set done = 1; 
open emp_cursor; 
read_loop: loop 
fetch emp_cursor into v_empno, v_ename, v_job, v_mgr, v_hiredate, v_sal, v_comm, 
v_deptno; 
if done = 1 then 
leave read_loop; 
end if; 
insert into emp1 
values(v_empno, v_ename, v_job, v_mgr, v_hiredate, v_sal, v_comm, v_deptno); 
end loop; 
close emp_cursor; 
end // 
delimiter ; 
call insert_emp1(10); 
select * from emp1; 
