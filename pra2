from collections import deque grid = [
['S', '.', 'X', '.', '.'],
['.', '.', 'X', '.', '.'],
['.', '.', '.', '.', '.'],
['X', 'X', '.', 'X', '.'],
['.', '.', '.', '.', 'G']
]

ROWS = len(grid) COLS = len(grid[0])

start = (0, 0)
goal = (4, 4)

moves = [
(-1, 0),	# Up
(1, 0),	# Down
(0, -1),	# Left
(0, 1)	# Right
]
 
class ModelBasedAgent: def 	init	(self):
self.visited = set()

def valid_move(self, row, col): if row < 0 or row >= ROWS:
return False
if col < 0 or col >= COLS: return False
if grid[row][col] == 'X': return False
return True

def search(self): queue = deque()
queue.append((start, [start])) self.visited.add(start)

while queue:
current, path = queue.popleft()

if current == goal: return path

for dr, dc in moves: nr = current[0] + dr
nc = current[1] + dc

if self.valid_move(nr, nc) and (nr, nc) not in self.visited: self.visited.add((nr, nc))
queue.append(((nr, nc), path + [(nr, nc)])) return None
agent = ModelBasedAgent() path = agent.search()

if path:
print("Goal Reached!\n") print("Path:")
 
for p in path: print(p)
else:
print("Goal Cannot Be Reached.")
