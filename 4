Create a table emp1 same as emp. 
I. Write a procedure to update salary of given employee to 3000 if salary is less than 3000 
else give 10 percentage increment on emp1 table.  
II. Write a plsql procedure which will insert all the details of given employee with empno to a 
new empty table emp1 which has same structure as emp; 



show databases; 
use seit26; 
CREATE TABLE emp1 AS SELECT * FROM emp WHERE 1=0; 
INSERT INTO emp1 SELECT * FROM emp; 
DELIMITER // 
CREATE PROCEDURE update_salary(IN p_empno INT) 
BEGIN 
DECLARE v_sal FLOAT; 
SELECT sal INTO v_sal 
FROM emp1 
WHERE empno = p_empno; 
IF v_sal < 3000 THEN 
UPDATE emp1 
SET sal = 3000 
WHERE empno = p_empno; 
ELSE 
UPDATE emp1 
SET sal = sal + (sal * 0.10) 
WHERE empno = p_empno; 
END IF; 
END // 
DELIMITER ; 
CALL update_salary(7369); 
SELECT * FROM emp1; 
DROP TABLE emp1; 
CREATE TABLE emp1 AS SELECT * FROM emp WHERE 1=0; 
DELIMITER // 
CREATE PROCEDURE insert_emp_details(IN p_empno INT) 
BEGIN 
INSERT INTO emp1 
SELECT * 
FROM emp 
WHERE empno = p_empno; 
END // 
DELIMITER ; 
CALL insert_emp_details(7839); 
SELECT * FROM emp1; 
