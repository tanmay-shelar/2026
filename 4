Practical 4
Apply internal, external, and inline CSS to style a web page with headings and tables.

HTML
<!DOCTYPE html>
<html>
<head>
    <title>CSS Types Example</title>

    <!-- External CSS -->
    <link rel="stylesheet" href="style.css">

    <!-- Internal CSS -->
    <style>
        h1 {
            color: darkblue;
            text-align: center;
        }

        table {
            width: 60%;
            border-collapse: collapse;
            margin: auto;
        }

        th {
            background-color: lightblue;
        }

        th, td {
            border: 1px solid black;
            padding: 10px;
            text-align: center;
        }
    </style>
</head>

<body>

    <!-- Inline CSS -->
    <h1 style="background-color: lightyellow;">
        Student Details Table
    </h1>

    <table>
        <tr>
            <th>Name</th>
            <th>Course</th>
            <th>Marks</th>
        </tr>

        <tr>
            <td>Rahul</td>
            <td>BCA</td>
            <td>85</td>
        </tr>

        <tr>
            <td>Priya</td>
            <td>BSc</td>
            <td>90</td>
        </tr>

        <tr>
            <td>Aman</td>
            <td>BCom</td>
            <td>78</td>
        </tr>
    </table>

</body>
</html>

CSS
body {
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
}


 
