Execute DDL/DML statements which demonstrate the use of views. 
I. Create table emp1 same as emp table;  
II. Create view dept20 for employees belonging to department 20 on table emp1.  
III. Update table emp1 increment comm by 100 where comm is not null using view dept20.  
IV. Delete record with empno = 7369 using view dept20.  
V. Create view dept30 for employees belonging to department 30 on table emp1 with check  
option.  
VI. Insert a record in view dept30 for given data (73,'akash','clerk',7902,'1980-12-17', 
800,null,20)  
show the error.  
VII. Create a view empview which will contain the empno, ename, sal, deptno,dname 
column.  
VIII. Delete view empview.  
IX. Delete view dept20.  
X. Delete view dept30. 



show databases; 
use seit26; 
create table emp1 as select * from emp; 
alter table emp1 add primary key(empno); 
create view dept20 as select * from emp1 where deptno = 20; 
select * from dept20; 
update dept20 set comm = comm + 100 where comm is not null; 
select * from dept20; 
delete from dept20 where empno = 7369; 
select * from dept20; 
create view dept30 as select * from emp1 where deptno = 30 with check option; 
select * from dept30; 
insert into dept30 values(73,'akash','clerk',7902,'1980-12-17',800,null,20); 
create view empview as select e.empno, e.ename, e.sal, e.deptno, d.dname from emp1 
e,dept d 
where e.deptno = d.deptno; 
select * from empview; 
drop view empview; 
drop view dept20; 
drop view dept30; 
