Practical 6
Write a JavaScript program to validate form inputs (e.g., email, empty fields).

<!DOCTYPE html>
<html>
<head>
  <title>Form Validation</title>

  <style>
    body {
      font-family: Arial;
      background: #f2f2f2;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .form-box {
      background: white;
      padding: 25px;
      border-radius: 10px;
      width: 300px;
      box-shadow: 0px 0px 10px rgba(0,0,0,0.2);
      text-align: center;
    }

    input {
      width: 90%;
      padding: 8px;
      margin: 10px 0;
    }

    button {
      width: 95%;
      padding: 10px;
      background: blue;
      color: white;
      border: none;
      cursor: pointer;
    }

    button:hover {
      background: darkblue;
    }

    #message {
      color: red;
      margin-top: 10px;
    }
  </style>
</head>

<body>

<div class="form-box">

  <h2>Login Form</h2>

  <form onsubmit="return validateForm()">

    <input type="text" id="name" placeholder="Enter Name">
    <input type="text" id="email" placeholder="Enter Email">

    <button type="submit">Submit</button>

  </form>

  <p id="message"></p>

</div>

<script>
function validateForm() {
  let name = document.getElementById("name").value.trim();
  let email = document.getElementById("email").value.trim();
  let message = document.getElementById("message");

  message.innerHTML = "";

  if (name === "" || email === "") {
    message.innerHTML = "Please fill all fields!";
    return false;
  }

  let pattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;

  if (!email.match(pattern)) {
    message.innerHTML = "Invalid email format!";
    return false;
  }

  alert("Form submitted successfully!");
  return true;
}
</script>

</body>
</html>

